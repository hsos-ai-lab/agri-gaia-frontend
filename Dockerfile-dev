# Run the development build inside the docker-compose network
FROM node:20-alpine

ARG VITE_PORTAINER_VERSION
RUN test -n "$VITE_PORTAINER_VERSION"
ENV VITE_PORTAINER_VERSION=${VITE_PORTAINER_VERSION}

# enter working directory
WORKDIR /code

# Copy the lockfile too so the dev server installs the exact, tested
# versions (e.g. vite 8.0.9) instead of drifting to newer patches that
# break the dev optimizeDeps pre-bundling (emotion/MUI "init_..._esm
# is not defined"). Requires package-lock.json to be out of .dockerignore.
COPY package.json package-lock.json ./

# install the locked dependency versions
RUN npm ci

# copy everything
COPY . .

# run the dev server
EXPOSE 80
CMD ["npm", "start"]
